@startuml
!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor white
hide empty members
title Notification Methods testability - proposed class design

class LendingServiceImpl {
 +LendingServiceImpl(..., channels: List<NotificationService>, readers: ReaderRepository, clock: Clock)
 +checkDueAndOverdueLendings(): void
}
interface NotificationService {
 +send(reader, event): void
}
class SMSNotificationService {
 +SMSNotificationService(readers: ReaderRepository)
 +send(reader, event): void
}
class EmailNotificationService {
 +EmailNotificationService(readers: ReaderRepository)
 +send(reader, event): void
}
class WebhookNotificationService {
 +send(reader, event): void
}
class "Channel composition" as Composition {
 +enabledChannels(identifiers): List<NotificationService>
}
class "Reader preference validation" as Preferences {
 +validateAndStore(reader, channels): void
}
interface ReaderRepository

LendingServiceImpl --> "0..*" NotificationService : injected enabled channels
LendingServiceImpl --> ReaderRepository : injected
SMSNotificationService ..|> NotificationService
EmailNotificationService ..|> NotificationService
WebhookNotificationService ..|> NotificationService
SMSNotificationService --> ReaderRepository : injected
EmailNotificationService --> ReaderRepository : injected
Composition ..> LendingServiceImpl : provides enabled channels
Preferences --> ReaderRepository : injected
@enduml
