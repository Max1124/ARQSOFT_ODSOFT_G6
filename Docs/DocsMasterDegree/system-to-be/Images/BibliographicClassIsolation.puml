@startuml
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam backgroundColor white
title Bibliographic coordinator test boundary
component "AAA test" as Test
rectangle "Small collaboration SUT" {
 component "Real BibliographicService" as Service
 component "Real ISBN validator" as Isbn
 Service --> Isbn : validate input
}
component "Source doubles\n(outside SUT)" as Sources
component "Merge double\n(outside SUT)" as Merge
Test --> Service : inputs / assertions
Service --> Sources
Service --> Merge
note bottom of Service : The real ISBN validator makes this a small collaboration\nunder the classroom single-class isolation convention.
@enduml
