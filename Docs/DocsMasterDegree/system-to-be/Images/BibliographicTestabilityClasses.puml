@startuml
!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor white
hide empty members
title Bibliographic testability - implemented class design
class BibliographicService {
 +BibliographicService(sources: List<BibliographicSource>, merge: BibliographicMerge)
 +retrieve(isbn): LookupResult
}
interface BibliographicSource {
 +lookupByIsbn(isbn): SourceOutcome
}
class BibliographicMerge {
 +combine(isbn, results): LookupResult
}
class GoogleBooksAdapter {
 +GoogleBooksAdapter(transport: BibliographicTransport, mapper: GoogleBooksMapper, endpoint: String)
 +lookupByIsbn(isbn): SourceOutcome
}
class OpenLibraryAdapter {
 +OpenLibraryAdapter(transport: BibliographicTransport, mapper: OpenLibraryMapper, endpoint: String)
 +lookupByIsbn(isbn): SourceOutcome
}
interface BibliographicTransport {
 +execute(request): TransportResponse
}
class HttpBibliographicTransport {
 +execute(request): TransportResponse
}
class GoogleBooksMapper {
 +map(isbn, body): SourceOutcome
}
class OpenLibraryMapper {
 +map(isbn, body): SourceOutcome
}
BibliographicService --> "1..*" BibliographicSource : injected sources
BibliographicService --> BibliographicMerge : injected
GoogleBooksAdapter ..|> BibliographicSource
OpenLibraryAdapter ..|> BibliographicSource
GoogleBooksAdapter --> BibliographicTransport : injected
OpenLibraryAdapter --> BibliographicTransport : injected
GoogleBooksAdapter --> GoogleBooksMapper : injected
OpenLibraryAdapter --> OpenLibraryMapper : injected
HttpBibliographicTransport ..|> BibliographicTransport
class BibliographicRegistrationService
class CatalogueMatcher
class AuthorCorrespondence
interface AuthorCorrespondenceRepository
BibliographicRegistrationService --> BibliographicService
BibliographicRegistrationService --> CatalogueMatcher
CatalogueMatcher --> AuthorCorrespondenceRepository
AuthorCorrespondenceRepository --> AuthorCorrespondence
@enduml
